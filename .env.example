# ---------------------------------------------------------------------------
# Local settings for running TrendRadar on your own computer.
#
#   1. Copy this file to ".env" (same folder).
#   2. Fill in the values. ".env" is in .gitignore and is never committed.
#   3. Try it:  uv run python scripts/preflight.py
#               uv run python -m trendradar --dry-run
#
# On GitHub Actions the same names are set as repository secrets instead
# (Settings → Secrets and variables → Actions). Never commit real values.
# ---------------------------------------------------------------------------

# --- Bright Data (required) ------------------------------------------------
BRIGHTDATA_API_KEY=
# Name of your SERP API zone (needed when brightdata.serp is enabled)
BRIGHTDATA_SERP_ZONE=
# Name of your Web Unlocker zone (needed when brightdata.web is enabled)
BRIGHTDATA_UNLOCKER_ZONE=

# --- Telegram (required for sending digests) --------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare R2 / S3 storage (required on GitHub Actions, optional locally)
# Locally, data is kept in the output/ folder when these are empty.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Optional: LLM for AI filtering / analysis / translation ----------------
# Only needed if you turn on ai_analysis, ai_translation or filter.method: ai
AI_API_KEY=
# LiteLLM model name, e.g. openai/gpt-4o-mini, anthropic/claude-haiku-4-5, deepseek/deepseek-chat
AI_MODEL=
AI_API_BASE=

# --- Optional switches -------------------------------------------------------
# DRY_RUN=true   collect + filter, print the digest instead of sending it
DRY_RUN=
